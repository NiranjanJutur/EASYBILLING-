# ShopLedger starts locally with no cloud account or API key required.
DATA_MODE=LOCAL
VITE_DATA_MODE=LOCAL

# Optional Supabase sync. Leave blank for local-only use.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional seller information for e-invoice integrations.
SELLER_PLACE=
SELLER_STATE_CODE=29
VITE_SELLER_PLACE=
VITE_SELLER_STATE_CODE=29
